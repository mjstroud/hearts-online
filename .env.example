# Copy to .env and adjust. Loaded at startup by `npm run dev` and `npm start`.

# Where the SQLite database lives. In production, point this at a persistent volume.
DATABASE_PATH=./data/hearts.db

# Optional: if set, new accounts must enter this code to sign up (keeps the site family-only).
SIGNUP_CODE=

# Server address for `npm start` (defaults: localhost / 4321).
# HOST=0.0.0.0
# PORT=8080
