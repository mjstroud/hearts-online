# Copy to .env and adjust. Loaded at startup by `npm run dev` and `npm start`.

# Where the SQLite database lives. In production, point this at a persistent volume.
DATABASE_PATH=./data/hearts.db

# Optional: if set, new accounts must enter this code to sign up (keeps the site family-only).
SIGNUP_CODE=

# Optional: comma-separated usernames that can open /admin and make password reset links.
ADMIN_USERNAMES=

# Optional: the one public address, e.g. https://shootthesun.com. Requests on any other host
# (the fly.dev name, www.) are redirected there, and reset links use it. Leave blank locally.
SITE_URL=

# Only the dev site sets this, to "dev" (fly.dev.toml): DEV badge, noindex and the /dev tools. Leave blank.
SITE_ENV=

# Server address for `npm start` (defaults: localhost / 4321).
# HOST=0.0.0.0
# PORT=8080
