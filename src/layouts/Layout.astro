---
import '../styles/fonts.css';
import '../styles/global.css';
import archivoLatin from '../assets/fonts/archivo-latin.woff2?url';
import geistLatin from '../assets/fonts/geist-latin.woff2?url';
import Avatar from '../components/Avatar.astro';
import { avatarSrc } from '../lib/avatars';
import { isAdmin } from '../lib/server/auth';
import { DECK_COOKIE, SITE_NAME } from '../lib/ui';

interface Props {
  title?: string;
  description?: string;
  /** Use the full-bleed layout (game table). */
  full?: boolean;
}

const { title, description = 'Online Hearts with house rules, for family games that run all year.', full = false } = Astro.props;
const user = Astro.locals.user;
const path = Astro.url.pathname;
const pageTitle = title ? `${title} · ${SITE_NAME}` : SITE_NAME;
const nav = user
  ? [
      { href: '/games', label: 'Games' },
      { href: '/stats', label: 'Stats' },
      { href: '/rules', label: 'How to play' },
    ]
  : [{ href: '/rules', label: 'How to play' }];
const active = (href: string) => path === href || path.startsWith(href + '/');
// Card colour preference lives in a cookie so the server renders the right deck (no flash).
const deck = Astro.cookies.get(DECK_COOKIE)?.value === 'four' ? 'four' : 'two';
---

<!doctype html>
<html lang="en" data-deck={deck}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0f0e0d" />
    {/* Home-screen app. iPhones prefer the two Apple tags to the manifest for the icon and name. */}
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content={SITE_NAME} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {/* Fonts are self-hosted (src/styles/fonts.css). Preload the two every page uses so text doesn't reflow late. */}
    <link rel="preload" href={archivoLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={geistLatin} as="font" type="font/woff2" crossorigin />
    <title>{pageTitle}</title>
  </head>
  <body class:list={{ full }}>
    <header class="site-header">
      <div class:list={['container', 'header-inner', { wide: full }]}>
        <a class="brand" href={user ? '/games' : '/'} aria-label={`${SITE_NAME} home`}>
          <span class="brand-mark" aria-hidden="true">♥</span>
          <span class="brand-name">{SITE_NAME}</span>
        </a>
        <nav class="nav" aria-label="Main">
          {nav.map((item) => <a href={item.href} class:list={{ active: active(item.href) }}>{item.label}</a>)}
        </nav>
        <div class="header-actions">
          {
            user ? (
              <details class="user-menu">
                <summary aria-label="Account menu" title={user.displayName}>
                  <Avatar name={user.displayName} seed={user.username} src={avatarSrc(user.avatarId)} size={30} />
                  <span class="user-name">{user.displayName}</span>
                </summary>
                <div class="menu panel">
                  <div class="menu-head">
                    <strong>{user.displayName}</strong>
                    <span class="faint">@{user.username}</span>
                  </div>
                  <a href="/account">Account</a>
                  {isAdmin(user) && <a href="/admin">Admin</a>}
                  <form method="post" action="/logout">
                    <button type="submit">Sign out</button>
                  </form>
                </div>
              </details>
            ) : (
              <>
                <a class="btn btn-ghost btn-sm" href="/login">Sign in</a>
                <a class="btn btn-primary btn-sm" href="/signup">Get started</a>
              </>
            )
          }
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    {
      !full && (
        <footer class="site-footer">
          <div class="container spread">
            <span class="faint">♥ {SITE_NAME} — one long game, wherever everyone is.</span>
            <nav class="row" style="--gap: 16px" aria-label="About this site">
              <a class="faint" href="/rules">House rules</a>
              <a class="faint" href="/terms">Terms</a>
              <a class="faint" href="/privacy">Privacy</a>
            </nav>
          </div>
        </footer>
      )
    }
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    /* Solid rather than backdrop-blurred: a live blur repaints on every scroll frame. */
    background: var(--header-bg);
    border-bottom: 1px solid var(--border);
    /* Under the status bar in a home-screen app; 0 in a browser. The sides come from .container. */
    padding-top: env(safe-area-inset-top, 0px);
  }

  .header-inner {
    height: 60px;
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    font-weight: 700;
    letter-spacing: -0.02em;
    font-size: 16px;
  }

  .brand-mark {
    width: 30px;
    height: 30px;
    display: grid;
    place-items: center;
    border-radius: 9px;
    color: #fff;
    font-size: 16px;
    background: linear-gradient(135deg, var(--heart-2), var(--heart));
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.35) inset,
      0 6px 18px -6px rgb(229 56 59 / 0.7);
  }

  .brand-name {
    font-family: var(--font-display);
    font-size: 19px;
    font-weight: 700;
    font-variation-settings: 'wdth' 108;
  }

  .nav {
    display: flex;
    gap: 4px;
  }

  .nav a {
    padding: 7px 12px;
    border-radius: 9px;
    color: var(--muted);
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    white-space: nowrap;
    transition:
      color 0.15s,
      background 0.15s;
  }

  .nav a:hover {
    color: var(--text);
    background: rgb(var(--hi) / 0.04);
  }

  .nav a.active {
    color: var(--text);
    background: rgb(var(--hi) / 0.07);
  }

  .header-actions {
    margin-left: auto;
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .user-menu {
    position: relative;
    min-width: 0;
  }

  .user-menu summary {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 4px 10px 4px 4px;
    border-radius: 99px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    border: 1px solid transparent;
  }

  .user-name {
    max-width: 160px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .user-menu summary::-webkit-details-marker {
    display: none;
  }

  .user-menu summary:hover,
  .user-menu[open] summary {
    background: rgb(var(--hi) / 0.05);
    border-color: var(--border);
  }

  .menu {
    position: absolute;
    right: 0;
    top: calc(100% + 8px);
    min-width: 200px;
    max-width: min(280px, calc(100vw - 24px));
    padding: 6px;
    border-radius: 14px;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-lg);
  }

  .menu-head {
    padding: 8px 10px 10px;
    display: flex;
    flex-direction: column;
    font-size: 14px;
    border-bottom: 1px solid var(--border);
    margin-bottom: 4px;
    overflow-wrap: anywhere;
  }

  .menu a,
  .menu button {
    all: unset;
    padding: 8px 10px;
    border-radius: 8px;
    font-size: 14px;
    cursor: pointer;
  }

  .menu form {
    display: contents;
  }

  .menu a:hover,
  .menu button:hover {
    background: rgb(var(--hi) / 0.06);
  }

  .site-footer {
    padding: 28px 0 40px;
    /* Clear of the home indicator. */
    padding-bottom: calc(40px + env(safe-area-inset-bottom, 0px));
    border-top: 1px solid var(--border);
    font-size: 13px;
  }

  @media (max-width: 720px) {
    .header-inner {
      gap: 12px;
    }

    .brand-name,
    .user-name {
      display: none;
    }

    .nav a {
      padding: 7px;
      font-size: 13.5px;
      white-space: nowrap;
    }
  }
</style>
