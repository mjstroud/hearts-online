---
import type { GameSettings } from '../lib/engine/rules';

interface Props {
  settings: GameSettings;
  /** House rules are locked once the game has started (the watches switch stays editable). */
  locked?: boolean;
}
const { settings, locked = false } = Astro.props;
const toggles: { name: keyof GameSettings; title: string; body: string }[] = [
  { name: 'jackOfDiamonds', title: 'Jack of Diamonds is −10', body: 'Whoever takes the J♦ subtracts 10 points.' },
  { name: 'shootTheMoon', title: 'Shoot the Moon', body: 'Take every heart and the Q♠ and everyone else gets +26.' },
  { name: 'shootTheSun', title: 'Shoot the Sun', body: 'Win every single trick and everyone else gets +52.' },
  {
    name: 'noPointsOnFirstTrick',
    title: 'No points on the first trick',
    body: 'Hearts and the Q♠ can’t be dumped on trick one unless that’s all you hold.',
  },
];
const pace: { name: keyof GameSettings; title: string; body: string }[] = [
  { name: 'autoPlayLast', title: 'Last trick plays itself', body: 'Everyone’s last card is played for them after the usual pause.' },
  {
    name: 'autoFinish',
    title: 'End hands early',
    body: 'Once nobody can take any more points, as everyone can see from the cards played, the rest is played out at once.',
  },
];
---

{
  /* Outside the locked fieldset on purpose: a disabled checkbox isn't submitted, which would read as
     "off". The hidden marker tells the server this form had the switch, so an unticked box means off. */
}
<label class="toggle">
  <input type="checkbox" name="showWatches" checked={settings.showWatches} />
  <span>
    <strong>Show Moon and Sun watches</strong>
    <small>Marks a player who could still shoot the Moon or the Sun. You can change this during the game.</small>
  </span>
</label>
<input type="hidden" name="watchesForm" value="1" />

{/* Never disabled, for the same reason: these can change mid-game. */}
<fieldset class="stack pace">
  <legend class="label">Pace {locked && <span class="faint">· you can change these during the game</span>}</legend>
  {
    pace.map((t) => (
      <label class="toggle">
        <input type="checkbox" name={t.name} checked={settings[t.name] as boolean} />
        <span>
          <strong>{t.title}</strong>
          <small>{t.body}</small>
        </span>
      </label>
    ))
  }
</fieldset>
<input type="hidden" name="paceForm" value="1" />

<fieldset class="stack rules" disabled={locked}>
  <legend class="label">House rules {locked && <span class="faint">· locked once cards are dealt</span>}</legend>
  {
    toggles.map((t) => (
      <label class="toggle">
        <input type="checkbox" name={t.name} checked={settings[t.name] as boolean} />
        <span>
          <strong>{t.title}</strong>
          <small>{t.body}</small>
        </span>
      </label>
    ))
  }
  <p class="hint deal-note">
    Every game uses a 4-card crib. Four players get 12 cards each. With five players the 2♣, 2♦ and 2♠ come out of the
    deck, so everyone gets 9.
  </p>
</fieldset>
<input type="hidden" name="rulesForm" value="1" />

<style>
  fieldset {
    border: 0;
    padding: 0;
    margin: 0;
    min-width: 0;
  }

  legend {
    padding: 0;
    margin-bottom: 10px;
  }

  fieldset:disabled .toggle {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .deal-note {
    padding: 0 4px;
  }
</style>
