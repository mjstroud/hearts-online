---
import type { GameSettings } from '../lib/engine/rules';

interface Props {
  settings: GameSettings;
  /** Rules are locked once the game has started (only the score limit can change). */
  locked?: boolean;
}
const { settings, locked = false } = Astro.props;
const toggles: { name: keyof GameSettings; title: string; body: string }[] = [
  { name: 'jackOfDiamonds', title: 'Jack of Diamonds is −10', body: 'Whoever takes the J♦ subtracts 10 points.' },
  { name: 'shootTheMoon', title: 'Shoot the Moon', body: 'Take every heart and the Q♠ and everyone else gets +26.' },
  { name: 'shootTheSun', title: 'Shoot the Sun', body: 'Win every single trick and everyone else gets +52.' },
  {
    name: 'noPointsOnFirstTrick',
    title: 'No points on the first trick',
    body: 'Hearts and the Q♠ can’t be dumped on trick one unless that’s all you hold.',
  },
];
---

<fieldset class="stack rules" disabled={locked}>
  <legend class="label">House rules {locked && <span class="faint">· locked once cards are dealt</span>}</legend>
  {
    toggles.map((t) => (
      <label class="toggle">
        <input type="checkbox" name={t.name} checked={settings[t.name] as boolean} />
        <span>
          <strong>{t.title}</strong>
          <small>{t.body}</small>
        </span>
      </label>
    ))
  }
  <p class="hint deal-note">
    Every game uses a 4-card crib. Four players get 12 cards each. With five players the 2♣, 2♦ and 2♠ come out of the
    deck, so everyone gets 9.
  </p>
</fieldset>
<input type="hidden" name="rulesForm" value="1" />

<style>
  fieldset {
    border: 0;
    padding: 0;
    margin: 0;
    min-width: 0;
  }

  legend {
    padding: 0;
    margin-bottom: 10px;
  }

  fieldset:disabled .toggle {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .deal-note {
    padding: 0 4px;
  }
</style>
