---
import Layout from '../layouts/Layout.astro';
import { createPasswordReset, isAdmin, listAccounts } from '../lib/server/auth';
import { readForm, siteOrigin } from '../lib/server/http';

const user = Astro.locals.user!;
if (!isAdmin(user)) return Astro.rewrite('/404');

let error = '';
let made: { link: string; name: string; expires: Date } | null = null;
if (Astro.request.method === 'POST') {
  const form = await readForm(Astro.request);
  if (form.intent === 'reset') {
    const res = createPasswordReset(Number(form.userId), user.id);
    if (!res) error = 'That account doesn’t exist.';
    else made = { link: `${siteOrigin(Astro.request)}/reset/${res.token}`, name: res.user.displayName, expires: res.expires };
  }
  if (error) Astro.response.status = 400;
}
Astro.response.headers.set('Cache-Control', 'no-store');
const accounts = listAccounts();
const when = (t: number) => new Date(t).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
---

<Layout title="Admin">
  <div class="container page" style="max-width: 820px">
    <div class="page-head">
      <div class="stack" style="--gap: 6px">
        <span class="eyebrow">Site admin</span>
        <h1 class="display">Accounts</h1>
        <p class="muted">Forgot a password? Make a reset link here and send it to them by text or email.</p>
      </div>
    </div>

    <div class="stack" style="--gap: 20px">
      {error && <p class="alert" role="alert">{error}</p>}
      {
        made && (
          <section class="panel panel-pad stack made" style="--gap: 10px">
            <strong>Reset link for {made.name}</strong>
            <input class="input mono" readonly value={made.link} onclick="this.select()" aria-label="Reset link" />
            <p class="muted small">
              It works once and expires {made.expires.toLocaleString('en-US', { dateStyle: 'medium', timeStyle: 'short' })}. Anyone
              with the link can set this account’s password, so only send it to them. Using it signs the account out on every device.
            </p>
          </section>
        )
      }

      <section class="panel accounts-wrap">
        <table class="accounts">
          <thead>
            <tr>
              <th>Name</th>
              <th>Joined</th>
              <th class="num">Devices</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            {
              accounts.map((a) => (
                <tr>
                  <td>
                    <strong title={a.displayName}>{a.displayName}</strong>
                    <span class="faint small">@{a.username}</span>
                  </td>
                  <td class="faint small">{when(a.createdAt)}</td>
                  <td class="num">{a.sessions}</td>
                  <td class="right">
                    <form method="post">
                      <input type="hidden" name="intent" value="reset" />
                      <input type="hidden" name="userId" value={a.id} />
                      <button class="btn btn-sm" type="submit" title={a.resetUntil ? 'A link is already out; making a new one cancels it' : ''}>
                        {a.resetUntil ? 'New reset link' : 'Make reset link'}
                      </button>
                    </form>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </section>
      <p class="faint small">Admins are the usernames listed in the <code>ADMIN_USERNAMES</code> setting on the server.</p>
    </div>
  </div>
</Layout>

<style>
  .accounts {
    width: 100%;
    border-collapse: collapse;
    font-size: 15px;
  }

  .accounts th {
    text-align: left;
    font-size: 12px;
    font-weight: 600;
    color: var(--muted);
    padding: 12px 18px;
  }

  .accounts td {
    padding: 10px 18px;
    border-top: 1px solid rgb(var(--hi) / 0.06);
    vertical-align: middle;
  }

  .accounts-wrap {
    overflow-x: auto;
  }

  .accounts td strong {
    display: block;
  }

  /* Let a long name or username wrap so the table fits the panel. */
  .accounts td:first-child {
    min-width: 9em;
    overflow-wrap: anywhere;
  }

  .num {
    text-align: right;
  }

  .right {
    text-align: right;
  }

  .small {
    font-size: 13px;
  }

  .mono {
    font-family: var(--font-mono, monospace);
    font-size: 13px;
  }

  .made {
    border-color: rgb(242 196 109 / 0.35);
    overflow-wrap: anywhere;
  }
</style>
