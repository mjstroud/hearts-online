---
import DeckToggle from '../components/DeckToggle.svelte';
import PlayingCard from '../components/PlayingCard.svelte';
import Layout from '../layouts/Layout.astro';
import { type Card, RANKS } from '../lib/engine/cards';
import { THEMES, THEME_COOKIE, themeById } from '../lib/themes';

// Exploratory page for comparing themes; goes away once one is chosen.
const current = themeById(Astro.cookies.get(THEME_COOKIE)?.value).id;
const rows: Card[][] = (['S', 'H', 'D', 'C'] as const).map((s) => RANKS.map((r) => `${r}${s}` as Card));
const sample: Card[] = ['AS', 'KH', 'QS', 'JD', 'TC', '7D', '2H'];
---

<Layout title="Theme lab">
  <div class="container page wide-lab">
    <div class="page-head">
      <div class="stack" style="--gap: 6px">
        <span class="eyebrow">Theme lab</span>
        <h1 class="display">Try on a look</h1>
        <p class="muted">Pick a theme to restyle the whole site. The choice is saved in this browser only.</p>
      </div>
      <DeckToggle client:load />
    </div>

    <div class="picker">
      {
        THEMES.map((t) => (
          <button type="button" class="pick" data-theme-pick={t.id} aria-pressed={t.id === current ? 'true' : 'false'}>
            <span class="pick-swatch" style={`--a: ${t.swatch[0]}; --b: ${t.swatch[1]}; --c: ${t.swatch[2]}`} aria-hidden="true">
              <i />
              <i />
            </span>
            <strong>{t.name}</strong>
            <small>{t.blurb}</small>
          </button>
        ))
      }
    </div>

    <section class="lab-section">
      <h2 class="panel-title">Table</h2>
      <div class="table-preview">
        <div class="rail">
          <div class="felt">
            <div class="felt-mark" aria-hidden="true"></div>
            <div class="felt-cards">
              <span style="--r: -8deg; --x: -64px"><PlayingCard card="QS" width={104} /></span>
              <span style="--r: 3deg; --x: 0px"><PlayingCard card="AH" width={104} /></span>
              <span style="--r: 9deg; --x: 64px"><PlayingCard card="TD" width={104} /></span>
              <span style="--r: -4deg; --x: 128px"><PlayingCard width={104} /></span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="lab-section">
      <h2 class="panel-title">Full deck</h2>
      <div class="deck">
        {
          rows.map((row) => (
            <div class="deck-row">
              {row.map((c) => (
                <PlayingCard card={c} width={80} />
              ))}
            </div>
          ))
        }
      </div>
    </section>

    <section class="lab-section">
      <h2 class="panel-title">Sizes</h2>
      <p class="faint small">Trick, hand, side panel, and the compact style used in tight spots.</p>
      {
        [124, 96, 64, 46, 36].map((w) => (
          <div class="size-row">
            <span class="faint num small">{w}px</span>
            {sample.map((c) => (
              <PlayingCard card={c} width={w} />
            ))}
            <PlayingCard width={w} />
          </div>
        ))
      }
    </section>
  </div>
</Layout>

<style>
  .wide-lab {
    max-width: 1280px;
  }

  .small {
    font-size: 12.5px;
  }

  .picker {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
    gap: 12px;
    margin-bottom: 36px;
  }

  .pick {
    all: unset;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding: 12px;
    border-radius: 16px;
    border: 1px solid var(--border);
    background: var(--surface);
    cursor: pointer;
  }

  .pick:hover {
    border-color: var(--border-strong);
  }

  .pick:focus-visible {
    outline: 2px solid var(--gold);
  }

  .pick[aria-pressed='true'] {
    border-color: var(--gold);
    box-shadow: 0 0 0 1px var(--gold);
  }

  .pick small {
    color: var(--muted);
    font-size: 12.5px;
    line-height: 1.35;
  }

  .pick-swatch {
    position: relative;
    height: 64px;
    margin-bottom: 8px;
    border-radius: 10px;
    background: radial-gradient(circle at 50% 40%, color-mix(in srgb, var(--a) 80%, white), var(--a));
    box-shadow: inset 0 0 0 3px color-mix(in srgb, var(--a) 60%, black);
  }

  .pick-swatch i:nth-child(1) {
    position: absolute;
    left: calc(50% - 26px);
    top: 10px;
    width: 30px;
    height: 42px;
    border-radius: 4px;
    background: var(--b);
    border: 2px solid rgb(255 255 255 / 0.8);
    transform: rotate(-10deg);
  }

  .pick-swatch i:nth-child(2) {
    position: absolute;
    left: calc(50% - 2px);
    top: 9px;
    width: 30px;
    height: 42px;
    border-radius: 4px;
    background: #fbf8f2;
    box-shadow: inset 0 0 0 2px var(--c);
    transform: rotate(8deg);
  }

  .lab-section {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 40px;
  }

  .deck {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .deck-row,
  .size-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }

  .size-row > span {
    width: 44px;
  }

  /* A small copy of the game table's rail and felt, so each theme's surface can be judged in isolation. */
  .table-preview {
    position: relative;
    height: 300px;
    max-width: 760px;
  }

  .rail {
    position: absolute;
    inset: 0;
    padding: var(--rail);
    border-radius: var(--felt-radius);
    background: var(--rail-bg);
    box-shadow: var(--rail-shadow);
  }

  .felt {
    position: relative;
    height: 100%;
    border-radius: max(0px, calc(var(--felt-radius) - var(--rail)));
    background: var(--felt-bg);
    box-shadow: var(--felt-shadow);
    overflow: hidden;
  }

  .felt::after {
    content: '';
    position: absolute;
    inset: var(--inlay-inset);
    border: var(--inlay);
    outline: var(--inlay-2);
    outline-offset: 3px;
    border-radius: max(0px, calc(var(--felt-radius) - var(--rail) - var(--inlay-inset)));
    pointer-events: none;
  }

  .felt-mark {
    position: absolute;
    left: 50%;
    top: 50%;
    width: var(--felt-mark-size);
    height: var(--felt-mark-size);
    transform: translate(-50%, -50%);
    background-color: var(--felt-mark-color);
    -webkit-mask: var(--felt-mark) center / contain no-repeat;
    mask: var(--felt-mark) center / contain no-repeat;
  }

  .felt-cards span {
    position: absolute;
    left: calc(50% - 116px + var(--x));
    top: calc(50% - 60px);
    transform: rotate(var(--r));
  }
</style>
