---
import PlayingCard from '../components/PlayingCard.svelte';
import Layout from '../layouts/Layout.astro';
import type { Card } from '../lib/engine/cards';

if (Astro.locals.user) return Astro.redirect('/games');

const fan: Card[] = ['7H', 'KH', 'QS', 'JD', 'AH'];
const features = [
  {
    icon: '🔒',
    title: 'Private tables',
    body: 'Each game has a join code, so only the family can sit down. Rejoin any time from any device.',
  },
  {
    icon: '⏳',
    title: 'Play at your own pace',
    body: 'Every card is saved the moment it’s played. Make your move tonight and someone else can answer tomorrow.',
  },
  {
    icon: '♦',
    title: 'Your house rules',
    body: 'Jack of Diamonds −10, a secret crib, Shooting the Sun, rotating passes, and five-player tables.',
  },
  {
    icon: '📈',
    title: 'Stats that settle arguments',
    body: 'A running scoreboard, plus who keeps eating the Queen and who always seems to get the Jack.',
  },
];
---

<Layout>
  <section class="hero container">
    <div class="copy">
      <span class="eyebrow">Hearts, the long game</span>
      <h1 class="display">The family card table,<br /><em>open all year.</em></h1>
      <p class="lede">
        A private online Hearts table for game nights that run for months. Play live together or a few tricks at a time,
        and the scoreboard keeps going.
      </p>
      <div class="row">
        <a class="btn btn-primary btn-lg" href="/signup">Create your account</a>
        <a class="btn btn-lg" href="/login">I already have one</a>
      </div>
      <a class="rules-link muted" href="/rules">New to Hearts? Read the house rules →</a>
    </div>
    <div class="fan" aria-hidden="true">
      {
        fan.map((card, i) => (
          <div class="fan-card" style={`--i: ${i - 2}`}>
            <PlayingCard card={card} width={128} />
          </div>
        ))
      }
      <div class="glow"></div>
    </div>
  </section>

  <section class="container features">
    {
      features.map((f) => (
        <article class="panel feature">
          <span class="icon">{f.icon}</span>
          <h3>{f.title}</h3>
          <p class="muted">{f.body}</p>
        </article>
      ))
    }
  </section>
</Layout>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    align-items: center;
    gap: 40px;
    padding-top: 72px;
    padding-bottom: 72px;
  }

  .copy {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  h1 {
    font-size: clamp(40px, 6vw, 68px);
    line-height: 1.02;
  }

  h1 em {
    font-style: italic;
    background: linear-gradient(90deg, var(--heart-2), var(--heart) 40%, var(--gold));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .lede {
    font-size: 18px;
    color: var(--muted);
    max-width: 520px;
  }

  .rules-link {
    font-size: 14px;
    text-decoration: none;
  }

  .rules-link:hover {
    color: var(--text);
  }

  .fan {
    position: relative;
    height: 380px;
    display: grid;
    place-items: center;
  }

  .fan-card {
    position: absolute;
    top: 70px;
    transform-origin: 50% 160%;
    transform: rotate(calc(var(--i) * 11deg)) translateY(calc(var(--i) * var(--i) * 4px));
    transition: transform 0.4s var(--ease);
    z-index: 1;
  }

  .fan:hover .fan-card {
    transform: rotate(calc(var(--i) * 14deg)) translateY(calc(var(--i) * var(--i) * 4px - 10px));
  }

  .glow {
    position: absolute;
    width: 360px;
    height: 260px;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(31 114 83 / 0.65), transparent);
    filter: blur(20px);
    top: 120px;
  }

  .features {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    padding-bottom: 80px;
  }

  .feature {
    padding: 22px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .feature h3 {
    font-size: 16px;
  }

  .feature p {
    font-size: 14px;
  }

  .icon {
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    border-radius: 11px;
    background: rgb(255 255 255 / 0.05);
    border: 1px solid var(--border);
    font-size: 18px;
    margin-bottom: 6px;
  }

  @media (max-width: 960px) {
    .hero {
      grid-template-columns: 1fr;
      padding-top: 40px;
      gap: 10px;
    }

    .fan {
      height: 300px;
    }

    .features {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 560px) {
    .features {
      grid-template-columns: 1fr;
    }

    .fan {
      transform: scale(0.8);
      height: 260px;
    }
  }
</style>
