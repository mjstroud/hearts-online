---
import AuthCard from '../components/AuthCard.astro';
import Layout from '../layouts/Layout.astro';
import { createSession, setSessionCookie, signUp, signupCodeRequired } from '../lib/server/auth';
import { DISPLAY_NAME_MAX, DISPLAY_NAME_MAX_UNITS } from '../lib/names';
import { clientIp, isSecure, readForm, safeNext } from '../lib/server/http';

const next = safeNext(Astro.url.searchParams.get('next'));
if (Astro.locals.user) return Astro.redirect(next);

const needCode = signupCodeRequired();
let error = '';
let values = { username: '', displayName: '' };
let agreed = false;
if (Astro.request.method === 'POST') {
  const form = await readForm(Astro.request);
  values = { username: form.username ?? '', displayName: form.displayName ?? '' };
  // The browser insists on the box too, but the server is what counts.
  agreed = form.agreeTerms === 'on';
  let addr = 'unknown';
  try {
    addr = Astro.clientAddress;
  } catch {}
  const result = await signUp(
    {
      ...values,
      password: form.password ?? '',
      confirmPassword: form.confirmPassword ?? '',
      signupCode: form.signupCode ?? '',
      agreedToTerms: agreed,
    },
    clientIp(Astro.request, addr),
  );
  if ('user' in result) {
    const { token, expires } = createSession(result.user.id);
    setSessionCookie(Astro.cookies, token, expires, isSecure(Astro.request));
    return Astro.redirect(safeNext(form.next), 303);
  }
  error = result.error;
  Astro.response.status = 400;
}
---

<Layout title="Create account">
  <AuthCard title="Pull up a chair" subtitle="Create an account to join the family table.">
    <form method="post" class="stack">
      <input type="hidden" name="next" value={next} />
      {error && <p class="alert" role="alert">{error}</p>}
      <label class="field">
        <span>Your name</span>
        <input class="input" name="displayName" maxlength={DISPLAY_NAME_MAX_UNITS} required value={values.displayName} placeholder="Grandma Jo" autofocus />
        <small class="hint">What everyone sees at the table. Up to {DISPLAY_NAME_MAX} characters.</small>
      </label>
      <label class="field">
        <span>Username</span>
        <input
          class="input"
          name="username"
          autocomplete="username"
          required
          minlength="3"
          maxlength="24"
          pattern="[a-zA-Z0-9_.\-]{3,24}"
          value={values.username}
          placeholder="grandmajo"
        />
        <small class="hint">For signing in. Letters, numbers, dots, dashes and underscores.</small>
      </label>
      <label class="field">
        <span>Password</span>
        <input class="input" name="password" type="password" autocomplete="new-password" required minlength="8" />
      </label>
      <label class="field">
        <span>Confirm password</span>
        <input class="input" name="confirmPassword" type="password" autocomplete="new-password" required minlength="8" />
      </label>
      {
        needCode && (
          <label class="field">
            <span>Family invite code</span>
            <input class="input" name="signupCode" required autocomplete="off" />
            <small class="hint">Ask whoever runs this site for the code.</small>
          </label>
        )
      }
      <label class="agree">
        <input type="checkbox" name="agreeTerms" required checked={agreed} />
        <span>
          I agree to the <a href="/terms" target="_blank" rel="noopener">Terms</a> and the <a href="/privacy" target="_blank" rel="noopener">Privacy Policy</a>
        </span>
      </label>
      <button class="btn btn-primary btn-lg btn-block" type="submit">Create account</button>
    </form>
    <p slot="below">Already have an account? <a href={`/login${next !== '/games' ? `?next=${encodeURIComponent(next)}` : ''}`}>Sign in</a></p>
  </AuthCard>
</Layout>

<script>
  import '../lib/name-field';
</script>

<style>
  .agree {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 14px;
    line-height: 1.45;
    cursor: pointer;
  }

  .agree input {
    flex: none;
    width: 18px;
    height: 18px;
    margin: 1px 0 0;
    accent-color: var(--mint);
    cursor: pointer;
  }
</style>
