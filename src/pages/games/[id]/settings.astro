---
import GameNav from '../../../components/GameNav.astro';
import RuleSettings from '../../../components/RuleSettings.astro';
import Layout from '../../../layouts/Layout.astro';
import { settingsFromForm } from '../../../lib/server/forms';
import { GameError, deleteGame, endGame, loadGame, updateSettings } from '../../../lib/server/games';
import { readForm } from '../../../lib/server/http';

const user = Astro.locals.user!;
let game = loadGame(Astro.params.id!);
if (!game) return Astro.redirect('/games?notice=missing');
if (game.ownerId !== user.id) return Astro.redirect(`/games/${game.id}`);

let error = '';
let saved = '';
if (Astro.request.method === 'POST') {
  const form = await readForm(Astro.request);
  try {
    if (form.intent === 'save') {
      updateSettings(game.id, user.id, form.name ?? '', settingsFromForm(form));
      saved = 'Settings saved.';
    } else if (form.intent === 'end-after') {
      endGame(game.id, user.id, 'after-hand');
      saved = 'The game will end as soon as the current hand is finished.';
    } else if (form.intent === 'end-cancel') {
      endGame(game.id, user.id, 'cancel');
      saved = 'The game will keep going.';
    } else if (form.intent === 'end-now') {
      if (form.confirm !== 'on') throw new GameError('Tick the box to confirm throwing away the current hand.');
      endGame(game.id, user.id, 'now');
      return Astro.redirect(`/games/${game.id}`, 303);
    } else if (form.intent === 'delete') {
      if (form.confirmName !== game.name) throw new GameError('Type the game’s exact name to delete it.');
      deleteGame(game.id, user.id);
      return Astro.redirect('/games', 303);
    }
  } catch (err) {
    error = err instanceof GameError ? err.message : 'Something went wrong.';
    Astro.response.status = 400;
  }
  game = loadGame(game.id)!;
}
const locked = game.status !== 'lobby' && game.mode !== 'playtest';
const finished = game.status === 'finished';
const maxScore = game.state ? Math.max(...game.state.scores) : 0;
const ending = !!game.state?.endAfterHand;
const handNumber = game.state?.hand?.number;
---

<Layout title={`Settings · ${game.name}`}>
  <div class="container page" style="max-width: 820px">
    <GameNav game={game} current="settings" isOwner />

    {error && <p class="alert" role="alert" style="margin-bottom: 18px">{error}</p>}
    {saved && <p class="alert ok" role="status" style="margin-bottom: 18px">{saved}</p>}

    {
      finished ? (
        <div class="panel panel-pad muted">This game is finished, so its settings are locked.</div>
      ) : (
        <form method="post" class="panel panel-pad stack" style="--gap: 22px">
          <input type="hidden" name="intent" value="save" />
          <label class="field">
            <span>Game name</span>
            <input class="input" name="name" required maxlength="60" value={game.name} />
          </label>
          <label class="field">
            <span>Score limit</span>
            <input
              class="input"
              name="scoreLimit"
              type="number"
              min="1"
              inputmode="numeric"
              placeholder="No limit"
              value={game.settings.scoreLimit ?? ''}
              style="max-width: 220px"
            />
            <small class="hint">
              Blank means no limit. The game ends after any hand where someone reaches the limit.
              {maxScore > 0 && ` The current high score is ${maxScore}.`}
            </small>
          </label>
          <RuleSettings settings={game.settings} locked={locked} />
          <div class="row" style="justify-content: flex-end">
            <button class="btn btn-primary" type="submit">Save changes</button>
          </div>
        </form>
      )
    }

    {
      game.status === 'active' && (
        <section class="ending stack">
          <h2 class="panel-title">Ending the game</h2>
          <form method="post" class="panel panel-pad stack" style="--gap: 12px">
            {ending ? (
              <>
                <input type="hidden" name="intent" value="end-cancel" />
                <div>
                  <strong>This is the final hand</strong>
                  <p class="muted small">
                    The game ends as soon as hand {handNumber} is finished. Everyone can see a “final hand” notice at the table.
                  </p>
                </div>
                <div>
                  <button class="btn" type="submit">
                    Keep playing instead
                  </button>
                </div>
              </>
            ) : (
              <>
                <input type="hidden" name="intent" value="end-after" />
                <div>
                  <strong>End after this hand</strong>
                  <p class="muted small">
                    Hand {handNumber} is played to the end and scored, then the game is over and the lowest total wins. You can
                    change your mind until the last card is played.
                  </p>
                </div>
                <div>
                  <button class="btn btn-gold" type="submit">
                    Make this the final hand
                  </button>
                </div>
              </>
            )}
          </form>
        </section>
      )
    }

    <section class="danger stack">
      <h2 class="panel-title">Danger zone</h2>
      {
        game.status === 'active' && (
          <form method="post" class="panel panel-pad stack" style="--gap: 12px">
            <input type="hidden" name="intent" value="end-now" />
            <div>
              <strong>End immediately</strong>
              <p class="muted small">
                For emergencies only, like when someone can’t finish the hand. The unfinished hand is thrown out and final
                standings come from the last completed hand.
              </p>
            </div>
            <label class="row small" style="--gap: 8px">
              <input type="checkbox" name="confirm" /> Yes, throw away hand {handNumber} and end “{game.name}” now
            </label>
            <div>
              <button class="btn btn-danger" type="submit">End now</button>
            </div>
          </form>
        )
      }
      <form method="post" class="panel panel-pad stack" style="--gap: 12px">
        <input type="hidden" name="intent" value="delete" />
        <div>
          <strong>Delete this game</strong>
          <p class="muted small">Permanently removes the game, its score sheet and its stats for every player. This can’t be undone.</p>
        </div>
        <label class="field">
          <span>Type <em>{game.name}</em> to confirm</span>
          <input class="input" name="confirmName" autocomplete="off" />
        </label>
        <div>
          <button class="btn btn-danger" type="submit">Delete game forever</button>
        </div>
      </form>
    </section>
  </div>
</Layout>

<style>
  .ending,
  .danger {
    margin-top: 36px;
    --gap: 12px;
  }

  .danger .panel {
    border-color: rgb(240 71 91 / 0.18);
  }

  .small {
    font-size: 14px;
  }

  em {
    font-style: normal;
    color: var(--text);
  }
</style>
