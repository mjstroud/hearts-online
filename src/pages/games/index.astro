---
import Layout from '../../layouts/Layout.astro';
import { listGamesForUser } from '../../lib/server/games';
import type { GameListItem } from '../../lib/types';
import { timeAgo } from '../../lib/ui';

const user = Astro.locals.user!;
const games = listGamesForUser(user.id);
const notices: Record<string, string> = {
  removed: 'You were removed from that game.',
  deleted: 'That game was deleted by its owner.',
  left: 'You left the game.',
  missing: 'We couldn’t find that game.',
};
const notice = notices[Astro.url.searchParams.get('notice') ?? ''];

const real = games.filter((g) => g.mode === 'normal');
const groups: { title: string; items: GameListItem[] }[] = [
  { title: 'Your move', items: real.filter((g) => g.status === 'active' && g.yourTurn) },
  { title: 'In progress', items: real.filter((g) => g.status === 'active' && !g.yourTurn) },
  { title: 'Waiting rooms', items: real.filter((g) => g.status === 'lobby') },
  { title: 'Finished', items: real.filter((g) => g.status === 'finished') },
  { title: '⚗ Playtest tables', items: games.filter((g) => g.mode === 'playtest') },
].filter((g) => g.items.length);
---

<Layout title="Your games">
  <div class="container page">
    <div class="page-head">
      <div class="stack" style="--gap: 6px">
        <span class="eyebrow">Hi, {user.displayName.split(' ')[0]}</span>
        <h1 class="display">Your games</h1>
      </div>
      <div class="row">
        <form method="post" action="/join" class="join">
          <input class="input code" name="code" placeholder="CODE" maxlength="6" aria-label="Join code" required autocomplete="off" />
          <button class="btn" type="submit">Join</button>
        </form>
        <a class="btn btn-ghost" href="/playtest" title="A solo sandbox with face-up cards and bots you control">⚗ Playtest</a>
        <a class="btn btn-primary" href="/games/new">+ New game</a>
      </div>
    </div>

    {notice && <p class="alert" style="margin-bottom: 20px">{notice}</p>}

    {
      games.length === 0 ? (
        <div class="panel empty-state">
          <div class="suits" aria-hidden="true">
            <span>♠</span>
            <span class="r">♥</span>
            <span>♣</span>
            <span class="r">♦</span>
          </div>
          <h2 class="display">No games yet</h2>
          <p class="muted">Start a table and share the join code, or enter a code someone sent you above.</p>
          <a class="btn btn-primary btn-lg" href="/games/new">Start your first game</a>
        </div>
      ) : (
        <div class="stack" style="--gap: 36px">
          {groups.map((group) => (
            <section class="stack" style="--gap: 12px">
              <h2 class="eyebrow">{group.title}</h2>
              <div class="grid">
                {group.items.map((g) => {
                  const sorted = g.players.slice().sort((a, b) => a.score - b.score);
                  return (
                    <a class:list={['panel', 'game', { turn: g.yourTurn && g.status === 'active' && g.mode === 'normal' }]} href={`/games/${g.id}`}>
                      <div class="spread">
                        <h3>{g.name}</h3>
                        {g.mode === 'playtest' ? <span class="badge sky">Playtest</span> : g.status === 'active' && g.yourTurn && <span class="badge heart pulse">Your turn</span>}
                        {g.status === 'lobby' && <span class="badge gold">{g.players.length}/5 seated</span>}
                        {g.status === 'finished' && <span class="badge">Final</span>}
                      </div>
                      {g.status === 'lobby' ? (
                        <p class="muted small">
                          {g.players.map((p) => p.name).join(', ')}
                          {g.isOwner && (
                            <>
                              {' '}
                              · code <span class="mono">{g.joinCode}</span>
                            </>
                          )}
                        </p>
                      ) : (
                        <ol class="mini-standings">
                          {sorted.map((p, i) => (
                            <li class:list={{ me: p.isMe }}>
                              <span class="pos num">{i + 1}</span>
                              <span class="pname">{p.isMe ? 'You' : p.name}</span>
                              <span class="num">{p.score}</span>
                            </li>
                          ))}
                        </ol>
                      )}
                      <div class="meta faint">
                        {g.status !== 'lobby' && (
                          <span class="num">
                            {g.handsPlayed} hand{g.handsPlayed === 1 ? '' : 's'}
                          </span>
                        )}
                        {g.status === 'active' && !g.yourTurn && g.waitingOn.length > 0 && (
                          <span>Waiting on {g.waitingOn.slice(0, 2).join(', ')}{g.waitingOn.length > 2 ? '…' : ''}</span>
                        )}
                        <span>{timeAgo(g.updatedAt)}</span>
                      </div>
                    </a>
                  );
                })}
              </div>
            </section>
          ))}
        </div>
      )
    }
  </div>
</Layout>

<style>
  .join {
    display: flex;
    gap: 8px;
  }

  .join .input {
    width: 130px;
    height: 40px;
    font-size: 14px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 14px;
  }

  .game {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 18px 20px;
    text-decoration: none;
    transition:
      transform 0.2s var(--ease),
      border-color 0.2s;
  }

  .game:hover {
    transform: translateY(-2px);
    border-color: var(--border-strong);
  }

  .game.turn {
    border-color: rgb(240 71 91 / 0.45);
    box-shadow:
      0 0 0 1px rgb(240 71 91 / 0.2),
      0 18px 50px -20px rgb(240 71 91 / 0.45);
  }

  .game h3 {
    font-size: 17px;
    font-family: var(--font-display);
    font-weight: 560;
  }

  .mini-standings {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: 14px;
  }

  .mini-standings li {
    display: grid;
    grid-template-columns: 18px 1fr auto;
    gap: 10px;
    padding: 3px 0;
  }

  .mini-standings li.me {
    font-weight: 600;
  }

  .mini-standings .pos {
    color: var(--faint);
    font-size: 12px;
  }

  .pname {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .meta {
    display: flex;
    gap: 14px;
    font-size: 12.5px;
    margin-top: auto;
    flex-wrap: wrap;
  }

  .small {
    font-size: 14px;
  }

  .mono {
    font-family: var(--font-mono);
    color: var(--gold);
  }

  /* Pulse an opacity ring (composited) instead of animating box-shadow (repaints every frame). */
  .pulse {
    position: relative;
    z-index: 0;
  }

  .pulse::after {
    content: '';
    position: absolute;
    z-index: -1;
    inset: -5px;
    border-radius: inherit;
    background: rgb(240 71 91 / 0.14);
    opacity: 0;
    animation: pulse 2s ease-in-out infinite;
    pointer-events: none;
  }

  @keyframes pulse {
    50% {
      opacity: 1;
    }
  }

  .empty-state {
    padding: 56px 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 14px;
  }

  .empty-state h2 {
    font-size: 28px;
  }

  .suits {
    display: flex;
    gap: 10px;
    font-size: 28px;
    color: var(--muted);
  }

  .suits .r {
    color: var(--heart);
  }
</style>
