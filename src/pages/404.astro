---
import PlayingCard from '../components/PlayingCard.svelte';
import Layout from '../layouts/Layout.astro';
---

<Layout title="Not found">
  <div class="container page lost">
    <PlayingCard card="QS" width={110} />
    <h1 class="display">Misdealt.</h1>
    <p class="muted">That page isn’t in the deck.</p>
    <a class="btn btn-primary" href="/">Back to the table</a>
  </div>
</Layout>

<style>
  .lost {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 14px;
    padding-top: 80px;
  }

  h1 {
    font-size: 44px;
    margin-top: 12px;
  }
</style>
