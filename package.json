{
  "name": "hearts-online",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Shoot the Sun: private online Hearts for family games that last all year.",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env ./node_modules/astro/bin/astro.mjs dev",
    "build": "astro build",
    "preview": "astro preview",
    "start": "node --env-file-if-exists=.env ./dist/server/entry.mjs",
    "test": "vitest run --dir src",
    "check": "astro check && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "check:budgets": "node scripts/check-budgets.mjs",
    "astro": "astro"
  },
  "allowScripts": {
    "esbuild": true
  },
  "dependencies": {
    "@astrojs/node": "^11.1.6",
    "@astrojs/svelte": "^9.0.1",
    "astro": "^7.3.5",
    "svelte": "^5.57.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/node": "^26.6.4",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
